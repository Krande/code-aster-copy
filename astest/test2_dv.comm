import numpy as np

DEBUT(CODE="OUI", DEBUG=_F(SDVERI="NON"))

### Model parameters
freq = 4.0  # [Hz]
omega = 2 * np.pi * freq  # [rad/s]
Iy = 1.0  # [kg.m2/rad]
kry = omega**2 * Iy  # [N.m/rad]

# Nonlinear behavior law parameters
nonlinear = False
limy_ry = 50.0
kcin_ry = 0.5 * kry

### Time integration parameters
dt = 5e-3  # [s]
t0 = 0  # [s]
tf = 1.0  # [s]

### Load parameters
freq_load = 3.5  # [Hz]
omega_load = 2 * np.pi * freq_load  # [rad/s]
my0 = 70.0  # [N.m]
phi0 = 0.0  # [rad]


### Mesh
MA0 = LIRE_MAILLAGE(FORMAT="ASTER")

MA = CREA_MAILLAGE(MAILLAGE=MA0, CREA_POI1=(_F(NOM_GROUP_MA="MB", GROUP_NO="B"),))

### Model
MO = AFFE_MODELE(
    MAILLAGE=MA,
    AFFE=(
        _F(GROUP_MA=("RESSORTS"), PHENOMENE="MECANIQUE", MODELISATION="DIS_TR"),
        _F(GROUP_MA=("MB"), PHENOMENE="MECANIQUE", MODELISATION="DIS_TR"),
    ),
)

### Elementary characteristics
CARA_ELE = AFFE_CARA_ELEM(
    MODELE=MO,
    DISCRET=(
        _F(CARA="K_TR_D_L", GROUP_MA="K1", VALE=(0, 0, 0, 0, kry, 0), REPERE="LOCAL"),
        _F(CARA="M_TR_D_N", GROUP_MA="MB", VALE=(0, 0, Iy, 0, 0, 0, 0, 0, 0, 0), REPERE="LOCAL"),
    ),
)

### Material
MATER = DEFI_MATERIAU(ELAS=_F(E=1.0, RHO=1.0, NU=0.25))
CHMAT = AFFE_MATERIAU(MAILLAGE=MA, AFFE=_F(GROUP_MA="RESSORTS", MATER=MATER))

### Boundary conditions
LIAISON = AFFE_CHAR_MECA(
    MODELE=MO,
    DDL_IMPO=(_F(TOUT="OUI", DX=0.0, DY=0.0, DZ=0.0, DRX=0.0, DRZ=0.0), _F(GROUP_NO="A", DRY=0.0)),
)


### Imposed load
LOAD = AFFE_CHAR_MECA(MODELE=MO, FORCE_NODALE=_F(GROUP_NO="B", MY=1.0))

F_MULT0 = FORMULE(
    VALE="my0*sin(omega_load*INST+phi0)", my0=my0, phi0=phi0, omega_load=omega_load, NOM_PARA="INST"
)

### Matrices assembly
ASSEMBLAGE(
    MODELE=MO,
    CARA_ELEM=CARA_ELE,
    CHARGE=LIAISON,
    NUME_DDL=CO("NUMEDDL"),
    MATR_ASSE=(
        _F(MATRICE=CO("RIGI"), OPTION="RIGI_MECA"),
        _F(MATRICE=CO("MASS"), OPTION="MASS_MECA"),
    ),
)

ASSEMBLAGE(
    MODELE=MO,
    CARA_ELEM=CARA_ELE,
    CHARGE=LOAD,
    NUME_DDL=NUMEDDL,
    VECT_ASSE=(_F(VECTEUR=CO("MRY"), OPTION="CHAR_MECA")),
)

### Modal basis
MODES = CALC_MODES(
    MATR_RIGI=RIGI,
    OPTION="CENTRE",
    CALC_FREQ=_F(NMAX_FREQ=1, FREQ=freq),
    MATR_MASS=MASS,
    SOLVEUR_MODAL=_F(METHODE="QZ"),
)

### Matrices and initial state projection
PROJ_BASE(
    BASE=MODES,
    MATR_ASSE_GENE=(
        _F(MATRICE=CO("MASS_GENE"), MATR_ASSE=MASS),
        _F(MATRICE=CO("RIGI_GENE"), MATR_ASSE=RIGI),
    ),
    VECT_ASSE_GENE=(_F(VECTEUR=CO("MRY_GENE"), VECT_ASSE=MRY, TYPE_VECT="FORC"),),
)


### Time discretization
L_INST = DEFI_LIST_REEL(DEBUT=t0, INTERVALLE=(_F(JUSQU_A=tf, PAS=dt),))

### Load multiplicative function
F_MULT = CALC_FONC_INTERP(FONCTION=F_MULT0, LIST_PARA=L_INST, NOM_PARA="INST")

### Set behavior law
if nonlinear:
    relation = "DIS_ECRO_CINE"
else:
    relation = "ELAS"

### Solve transient problem
RESU_GENE = DYNA_VIBRA(
    TYPE_CALCUL="TRAN",
    BASE_CALCUL="GENE",
    MATR_MASS=MASS_GENE,
    MATR_RIGI=RIGI_GENE,
    EXCIT=(_F(VECT_ASSE_GENE=MRY_GENE, FONC_MULT=F_MULT),),
    SCHEMA_TEMPS=_F(SCHEMA="NEWMARK"),
    INCREMENT=_F(INST_FIN=tf, PAS=dt / 4),
    ARCHIVAGE=_F(PAS_ARCH=1),
    COMPORTEMENT=_F(
        RELATION="DIS_ECRO_CINE",
        GROUP_NO_1="A",
        GROUP_NO_2="B",
        KELA_RY=kry,
        LIMY_RY=limy_ry,
        KCIN_RY=kcin_ry,
    ),
)

## Post-processing
RESU = REST_GENE_PHYS(RESU_GENE=RESU_GENE, NOM_CHAM=("DEPL", "VITE", "ACCE"))

TAB = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="DEPLACEMENT",
        RESULTAT=RESU,
        NOM_CHAM="DEPL",
        TOUT_ORDRE="OUI",
        GROUP_NO="B",
        NOM_CMP="DRY",
    )
)

t = TAB.EXTR_TABLE().values()["INST"]
dry = TAB.EXTR_TABLE().values()["DRY"]

print("RESU")
for i, tt in enumerate(t):
    print(tt, dry[i])


# ------------------------------------------------------------------------------
###
FIN()
