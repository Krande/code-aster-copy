DEBUT(IGNORE_ALARM=("MED_83", "CALCULEL4_24"))

from code_aster.Utilities import get_version

#version = get_version().split(".")
#version = int(f"{int(version[0]):02d}{int(version[1]):02d}{int(version[2]):02d}")

version = "%02d%02d%02d"%tuple([int(x) for x in get_version().split(".")])

print(version)

tr6 = LIRE_MAILLAGE(UNITE=20)
tr7 = LIRE_MAILLAGE(UNITE=21)
qu8 = LIRE_MAILLAGE(UNITE=22)
qu9 = LIRE_MAILLAGE(UNITE=23)
mesh_by_type = {"TR6": tr6, "TR7": tr7, "QU8": qu8, "QU9": qu9}

values_by_type = {"TR6": (0., 0., 0., 1./3, 1./3, 1./3),
                  "QU8": (-1./12, -1./12, -1./12, -1./12, 1./3, 1./3, 1./3, 1./3),
                  "QU9": (1./36, 1./36, 1./36, 1./36, 1./9, 1./9, 1./9, 1./9, 4./9)}
for typ in ("TR6", "QU8", "QU9"):

    mesh = mesh_by_type[typ]
    values = values_by_type[typ]

    model = AFFE_MODELE(MAILLAGE=mesh,
                        AFFE=(_F(GROUP_MA="DALLE", PHENOMENE="MECANIQUE", MODELISATION="3D"),
                              _F(GROUP_MA="RESSORT", PHENOMENE="MECANIQUE", MODELISATION="DIS_T")
                              )
                        )

    carelem = AFFE_CARA_ELEM(
        MODELE=model,
        RIGI_PARASOL=_F(
            GROUP_MA="DALLE",
            GROUP_MA_SEG2="RESSORT",
            REPERE="GLOBAL",
            COEF_GROUP=1,
            CARA="K_T_D_L",
            VALE=(0.0, 0.0, 1.0),
            COOR_CENTRE=(0,0,0),
        ),
    )

    DEFI_FICHIER(UNITE=80, FICHIER="./fort.80", TYPE="BINARY")
    IMPR_CONCEPT(UNITE=80, FORMAT="MED", CONCEPT=_F(CARA_ELEM=carelem, REPERE_LOCAL="ELEM", MODELE=model))
    cardisck = LIRE_CHAMP(
        TYPE_CHAM="ELEM_CADISK_R",
        UNITE=80,
        NUME_PT=0,
        NUME_ORDRE=0,
        MAILLAGE=mesh,
        MODELE=model,
        NOM_MED=f"{carelem.getName()}#CARDISCK",
        NOM_CMP_IDEM="OUI",
        PROL_ZERO='OUI',
    )
    DEFI_FICHIER(UNITE=80, ACTION="LIBERER")

    for i, value in enumerate(values, 1):
        TEST_RESU(CHAM_ELEM=_F(CHAM_GD=cardisck,
                               NOM_CMP = "K6",
                               GROUP_MA = f"P{i}",
                               REFERENCE="ANALYTIQUE",
                               VALE_REFE = value,
                               VALE_CALC = value,
                               CRITERE = "ABSOLU" if value==0.0 else "RELATIF"))


